# MongoDB connection string (remote server)
MONGODB_URL=mongodb://username:password@your-server-ip:27017/mcv-discord-bot

# Discord
DISCORD_TOKEN=
CLIENT_ID=
ADMIN_USER_ID=

# Cookie จาก MyCourseVille (เปิด browser แล้วรัน document.cookie ใน console)
COOKIE=

# ระยะเวลา (วินาที) ระหว่างการ fetch เพื่อป้องกัน rate limit
DELAY=300

# true = แจ้งเตือน admin ใน Discord เมื่อ fetch error
ERROR_FETCHING_NOTIFICATION=false
