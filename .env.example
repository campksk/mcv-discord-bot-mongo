# MongoDB connection string (Local or Remote Server)
# Example: mongodb://username:password@your-server-ip:27017/mcv-discord-bot
MONGODB_URL=

# Your Discord Bot Token (Get this from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Your Discord Application Client ID
CLIENT_ID=

# Administrator's Discord User ID (Used for receiving bot error notifications)
# How to get it: Enable Developer Mode in Discord -> Right-click your profile -> Copy User ID
ADMIN_USER_ID=

# Session Cookie used to fetch assignment data from MyCourseVille
# How to get it: Log in to https://www.mycourseville.com/ -> Press F12 to open Console -> Type `document.cookie` -> Press Enter
COOKIE=

# Delay (in seconds) between each fetch cycle to prevent rate limiting
DELAY=120

# Set to 'true' to send direct messages to the ADMIN_USER_ID when a fetch error occurs
ERROR_FETCHING_NOTIFICATION=false